SECRET_KEY=замените_на_случайную_строку_32_символа
# Comma-separated list of origins allowed to make credentialed cross-origin requests
# (e.g. https://v.just-skill.ru). Required — the app refuses to start without it.
ALLOWED_ORIGINS=http://localhost
DATABASE_URL=sqlite+aiosqlite:////data/vrising.db
VRISING_SERVER_IP=127.0.0.1
VRISING_SERVER_PORT=27016
# Optional: backend (Python) error monitoring via Sentry. Leave empty to disable
# entirely (default) — no Sentry account required for the site to run normally.
SENTRY_DSN=
# Tags every Sentry event so issues can be filtered by deploy (staging vs prod etc.) —
# only read when SENTRY_DSN is set.
ENVIRONMENT=production
# Optional: self-hosted Umami analytics (docker-compose.yml's `umami`/`umami-db`
# services, see docs/umami-setup.md). Defaults below work for local/testing only —
# generate real random values before running this in production.
UMAMI_APP_SECRET=замените_на_случайную_строку_32_символа
UMAMI_DB_PASSWORD=замените_на_случайный_пароль_postgres
# Optional: offsite copy destination for the nightly auto-backup (in addition to the
# local copy in the db_data volume / BACKUP_DIR). Leave empty to disable (default). Must
# be a path INSIDE the `web` container — mount your real remote/network share as a volume
# in docker-compose.yml and point this at that mount point. See README.md's "Резервные
# копии" section for a worked example (rclone mount / NFS / SMB).
BACKUP_REMOTE_PATH=
